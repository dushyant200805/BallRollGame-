{
  "expo": {
    "name": "Ball Roll",
    "slug": "ball-roll",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ballroll",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f1e2e",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.ballroll.game",
      "buildNumber": "1",
      "supportsTablet": true,
      "requireFullScreen": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "com.ballroll.game",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-mono.png",
        "backgroundColor": "#1e3d58"
      },
      "permissions": [
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0f1e2e"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/fredoka/Fredoka_500Medium.ttf",
            "node_modules/@expo-google-fonts/fredoka/Fredoka_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/fredoka/Fredoka_700Bold.ttf"
          ]
        }
      ],
      "expo-asset",
      "./plugins/withReleaseSigning"
    ]
  }
}
